# BootFete 2K26 — environment template. Copy to `.env` and fill in real values.
# Never commit a filled-in `.env` (it carries secrets).

# REQUIRED: public base URL of the app, used to build links inside emails
# (password resets, event links, test links). There is NO fallback domain —
# if this is unset, the server boots in a degraded mode and any attempt to
# build a link-bearing email fails loudly instead of sending a dead link.
APP_URL=https://your-domain-here

# REQUIRED: envelope sender identity for all outbound mail. Must be an
# address on a domain whose DNS (SPF/DKIM) this deployment controls —
# mail from an unauthenticated domain gets rejected or spam-filtered.
# There is NO fallback: if unset, sending fails loudly instead of using a
# dead domain.
SENDER_EMAIL=info@your-domain-here

# Brevo (used when the active email provider is Brevo). Never hardcode.
BREVO_API_KEY=your-brevo-api-key-here

# Database (Neon). Local dev may use LOCAL_DATABASE_URL instead (see RUNBOOK).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth/session
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Runtime
NODE_ENV=production
PORT=5000

# Redis (email queue, realtime, rate limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (SMTP provider, e.g. Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=info@example.com
